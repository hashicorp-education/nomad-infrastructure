# AWS Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "nomad-consul"
owner        = "your-name" # Replace with your name
environment  = "dev"

# Network Configuration
vpc_cidr         = "10.0.0.0/16"
subnet_cidr      = "10.0.1.0/24"
allowed_ssh_cidr     = "0.0.0.0/0" # Change this to your IP for better security


# AMI Configuration
ami_owner     = "099720109477" # Canonical
ami_name_filter     = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"
ami_architecture     = "x86_64"

# Instance Configuration
server_count         = 3
client_count         = 2
server_instance_type = "t3.micro"
client_instance_type = "t3.medium"

# For the Get Started tutorials (deploy_get_started.yaml), use a single
# combined server+client node instead:
# server_count = 1
# client_count = 0

# SSH Configuration
ssh_user = "ubuntu"

# Extra application ingress ports (opened to 0.0.0.0/0)
# Add one object per application port you want to expose.
# Remove entries to close ports. Defaults to the Countdash demo app port.
# extra_ingress_ports = [
#   { port = 9002, description = "Countdash example app - web UI" },
#   { port = 8080, description = "My application" },
# ]

# Optional external Application Load Balancer, for the Load Balancer
# Integrations tutorial (https://developer.hashicorp.com/nomad/tutorials/load-balancing).
# Disabled by default. Creates a second, instance-free subnet (AWS requires
# two AZs for an ALB) and forwards port 80 to load_balancer_target_port on
# every Nomad client.
# enable_load_balancer      = true
# load_balancer_target_port = 9002
