[Unit]
Description=Consul Agent
Documentation=https://developer.hashicorp.com/consul/docs
Requires=network-online.target
After=network-online.target

[Service]
User={{ consul_user }}
Group={{ consul_group }}
PIDFile={{ consul_pid_file }}
PermissionsStartOnly=true
ExecStartPre=-/bin/mkdir -m 0750 -p {{ consul_run_path }}
ExecStartPre=/bin/chown -R {{ consul_user }}:{{ consul_group }} {{ consul_run_path }}
ExecStart=/usr/local/bin/consul agent \
    -config-dir={{ consul_config_dir }} \
    -pid-file={{ consul_pid_file }}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
Restart={{ consul_systemd_restart }}
RestartSec={{ consul_systemd_restart_sec }}s
LimitNOFILE={{ consul_systemd_limit_nofile }}
# Allow binding to privileged ports if needed (e.g. future DNS on port 53)
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Consul manages its own log file; suppress systemd duplicate capture
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
