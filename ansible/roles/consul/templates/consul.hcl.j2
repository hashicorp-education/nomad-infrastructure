# Consul Agent Configuration
# Generated by Ansible — do not edit manually

datacenter = "{{ consul_datacenter }}"
domain     = "{{ consul_domain }}"
node_name  = "{{ consul_node_name }}"
data_dir   = "{{ consul_data_dir }}"

log_level  = "{{ consul_log_level }}"
log_file   = "{{ consul_log_dir }}/"
enable_debug = {{ consul_enable_debug | lower }}

bind_addr      = "{{ consul_bind_addr }}"
advertise_addr = "{{ consul_bind_addr }}"
client_addr    = "{{ consul_client_addr }}"

{% if consul_edition == 'enterprise' %}
license_path = "{{ consul_license_dir }}/license.hclic"

{% endif %}
{% if consul_tls_enabled %}
# Hybrid access model: plain HTTP stays on loopback for local automation and
# Nomad's local consul{} integration; HTTPS is exposed on all interfaces.
addresses {
  http  = "{{ consul_addr_http }}"
  https = "{{ consul_addr_https }}"
}

{% endif %}
ports {
  http     = {{ consul_port_http }}
  https    = {{ consul_port_https }}
  grpc     = {{ consul_port_grpc }}
  grpc_tls = {{ consul_port_grpc_tls }}
  serf_lan = {{ consul_port_serf_lan }}
  serf_wan = {{ consul_port_serf_wan }}
  server   = {{ consul_port_server }}
  dns      = {{ consul_port_dns }}
}

server           = {{ consul_server_enabled | lower }}
{% if consul_server_enabled %}
bootstrap_expect = {{ consul_server_bootstrap_expect }}

ui_config {
  enabled = {{ consul_ui_enabled | lower }}
}
{% endif %}

# Retry join — servers to join on startup
retry_join = [
{% if consul_cloud_auto_join_enabled %}
  "provider=aws tag_key={{ consul_cloud_auto_join_tag_key }} tag_value={{ consul_cloud_auto_join_tag_value }}"
{% elif consul_retry_join | length > 0 %}
{% for addr in consul_retry_join %}
  "{{ addr }}"{% if not loop.last %},{% endif %}

{% endfor %}
{% else %}
{% for host in groups['servers'] %}
  "{{ hostvars[host]['ansible_facts']['default_ipv4']['address'] }}"{% if not loop.last %},{% endif %}

{% endfor %}
{% endif %}
]

{% if consul_gossip_encryption_enabled and consul_gossip_encryption_key != "" %}
# Gossip encryption key — generate with: consul keygen
encrypt = "{{ consul_gossip_encryption_key }}"

{% endif %}
{% if consul_tls_enabled %}
tls {
  https {
    ca_file         = "{{ consul_tls_dir }}/ca.pem"
    cert_file       = "{{ consul_tls_dir }}/consul.pem"
    key_file        = "{{ consul_tls_dir }}/consul-key.pem"
    verify_incoming = false
    verify_outgoing = true
  }
  internal_rpc {
    ca_file                 = "{{ consul_tls_dir }}/ca.pem"
    cert_file               = "{{ consul_tls_dir }}/consul.pem"
    key_file                = "{{ consul_tls_dir }}/consul-key.pem"
    verify_incoming         = true
    verify_outgoing         = true
    verify_server_hostname  = true
  }
{% if consul_connect_enabled %}
  # gRPC/xDS interface (Consul Connect / Envoy sidecars). Without this stanza
  # the grpc_tls listener has no cert material of its own (it only inherits
  # from tls.defaults, which we do not set), causing Envoy's xDS stream to
  # fail the TLS handshake with "tlsv1 alert unrecognized name".
  grpc {
    ca_file         = "{{ consul_tls_dir }}/ca.pem"
    cert_file       = "{{ consul_tls_dir }}/consul.pem"
    key_file        = "{{ consul_tls_dir }}/consul-key.pem"
    verify_incoming = false
  }
{% endif %}
}

{% endif %}
{% if consul_acl_enabled %}
acl {
  enabled                  = true
  default_policy           = "{{ consul_acl_default_policy }}"
  enable_token_persistence = {{ consul_acl_enable_token_persistence | lower }}
{% if consul_acl_agent_token or consul_acl_dns_token %}
  tokens {
{% if consul_acl_agent_token %}
    agent = "{{ consul_acl_agent_token }}"
{% endif %}
{% if consul_acl_dns_token %}
    dns   = "{{ consul_acl_dns_token }}"
{% endif %}
  }
{% endif %}
}

{% endif %}
{% if consul_connect_enabled %}
connect {
  enabled = true
}

{% endif %}
performance {
  raft_multiplier  = {{ consul_performance.raft_multiplier }}
  leave_drain_time = "{{ consul_performance.leave_drain_time }}"
  rpc_hold_timeout = "{{ consul_performance.rpc_hold_timeout }}"
}
{% if consul_telemetry_enabled %}

telemetry {
  disable_hostname          = true
  prometheus_retention_time = "{{ consul_telemetry_prometheus_retention_time }}"
}
{% endif %}
