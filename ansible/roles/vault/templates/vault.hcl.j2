{% set vault_scheme = 'https' if vault_tls_enabled else 'http' %}
# Vault Configuration File
# Generated by Ansible

ui = {{ vault_ui_enabled | lower }}

log_level = "{{ vault_log_level }}"

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ vault_node_name }}"

{% if vault_cloud_auto_join_enabled %}
  retry_join {
    auto_join        = "provider=aws tag_key={{ vault_cloud_auto_join_tag_key }} tag_value={{ vault_cloud_auto_join_tag_value }}"
    auto_join_scheme = "{{ vault_scheme }}"
{% if vault_tls_enabled %}
    leader_ca_cert_file = "{{ vault_config_dir }}/.tls/ca.crt"
{% endif %}
  }
{% else %}
{% for host in groups['servers'] %}
{% if host != inventory_hostname %}
  retry_join {
    leader_api_addr = "{{ vault_scheme }}://{{ hostvars[host]['ansible_facts']['default_ipv4']['address'] }}:{{ vault_api_port }}"
{% if vault_tls_enabled %}
    leader_ca_cert_file = "{{ vault_config_dir }}/.tls/ca.crt"
{% endif %}
  }
{% endif %}
{% endfor %}
{% endif %}
}

listener "tcp" {
  address         = "0.0.0.0:{{ vault_api_port }}"
  cluster_address = "0.0.0.0:{{ vault_cluster_port }}"
{% if vault_tls_enabled %}
  tls_cert_file = "{{ vault_config_dir }}/.tls/vault.crt"
  tls_key_file  = "{{ vault_config_dir }}/.tls/vault.key"
{% else %}
  tls_disable = true
{% endif %}
}

cluster_addr = "{{ vault_scheme }}://{{ ansible_facts['default_ipv4']['address'] }}:{{ vault_cluster_port }}"
api_addr     = "{{ vault_scheme }}://{{ ansible_facts['default_ipv4']['address'] }}:{{ vault_api_port }}"
