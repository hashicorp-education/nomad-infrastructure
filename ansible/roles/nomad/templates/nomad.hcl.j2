# Nomad Configuration File
# Generated by Ansible

data_dir  = "{{ nomad_data_dir }}"
name      = "{{ nomad_node_name }}"
#bind_addr = "{{ ansible_facts['default_ipv4']['address'] }}"

log_level            = "{{ nomad_log_level }}"
log_include_location = {{ nomad_log_include_location | lower }}
log_file             = "{{ nomad_log_file }}"
enable_debug         = {{ nomad_enable_debug | lower }}

{% if nomad_tls_enabled %}
tls {
  http = true
  rpc  = true

  ca_file   = "{{ nomad_config_dir }}/.tls/ca.crt"
  cert_file = "{{ nomad_config_dir }}/.tls/nomad.crt"
  key_file  = "{{ nomad_config_dir }}/.tls/nomad.key"

  verify_server_hostname = true
  verify_https_client    = false
}
{% endif %}

{% if nomad_telemetry_enabled %}
telemetry {
  publish_allocation_metrics = true
  publish_node_metrics       = true
  prometheus_metrics         = {{ nomad_telemetry_prometheus_metrics | lower }}
}
{% endif %}

{% if nomad_server_enabled %}
server {
  enabled          = true
  bootstrap_expect = {{ nomad_server_bootstrap_expect }}
{% if nomad_cloud_auto_join_enabled %}

  server_join {
    retry_join = ["provider=aws tag_key={{ nomad_cloud_auto_join_tag_key }} tag_value={{ nomad_cloud_auto_join_tag_value }}"]
  }
{% else %}
  server_join {
    retry_join = [
      {% for host in groups['servers'] %}
      "{{ hostvars[host]['ansible_facts']["default_ipv4"]["address"] }}",
      {% endfor %}
    ]
  }
{% endif %}
}
{% endif %}

{% if nomad_client_enabled %}
client {
  enabled           = true

{% if nomad_cloud_auto_join_enabled %}

  server_join {
    retry_join = ["provider=aws tag_key={{ nomad_cloud_auto_join_tag_key }} tag_value={{ nomad_cloud_auto_join_tag_value }}"]
  }
{% else %}
  server_join {
    retry_join = [
      {% for host in groups['servers'] %}
      "{{ hostvars[host]['ansible_facts']["default_ipv4"]["address"] }}",
      {% endfor %}
    ]
  }
{% endif %}
{% if nomad_consul_integration_enabled and not nomad_consul_workload_identity_enabled and nomad_client_use_consul_token %}

  template {
    use_client_consul_token = true
  }
{% endif %}
{% if nomad_client_meta %}

  meta {
{% for k, v in nomad_client_meta.items() %}
    {{ k }} = "{{ v }}"
{% endfor %}
  }
{% endif %}
}
{% endif %}

{% if nomad_acl_enabled %}
acl {
  enabled = true
}
{% endif %}

{% if nomad_consul_integration_enabled %}
consul {
  address = "{{ nomad_consul_address }}"
  token   = "{{ nomad_consul_agent_token }}"

{% if nomad_client_enabled and nomad_consul_connect_enabled %}
  # Consul Connect (service mesh) gRPC integration. Envoy sidecars launched by
  # this client talk to the local Consul agent's TLS-enabled gRPC xDS listener.
  grpc_address = "{{ nomad_consul_grpc_address }}"
  grpc_ca_file = "{{ nomad_consul_grpc_ca_file }}"

{% endif %}
{% if nomad_consul_workload_identity_enabled %}
  # Default workload identity for Nomad services registering in Consul.
  # Nomad servers inject this identity into all jobs that use the Consul
  # service provider, removing the need to define it per job.
  service_identity {
    aud = ["{{ nomad_consul_service_identity_aud }}"]
    ttl = "{{ nomad_consul_service_identity_ttl }}"
  }

  # Default workload identity for Nomad tasks that access Consul data
  # (e.g. via template blocks reading service addresses or KV values).
  task_identity {
    aud = ["{{ nomad_consul_task_identity_aud }}"]
    ttl = "{{ nomad_consul_task_identity_ttl }}"
  }
{% endif %}
}
{% endif %}

{% if nomad_vault_integration_enabled %}
vault {
  enabled = true
  address = "{{ nomad_vault_address }}"

{% if nomad_tls_enabled %}
  ca_file = "{{ nomad_config_dir }}/.tls/ca.crt"
{% endif %}
{% if nomad_vault_workload_identity_enabled %}
  jwt_auth_backend_path = "{{ nomad_vault_jwt_auth_backend_path }}"

  # Default workload identity for Nomad tasks that use a vault {} block.
  # Nomad servers inject this identity into every task; the Vault JWT auth
  # method exchanges it for a scoped Vault token without a static token.
  default_identity {
    aud = ["{{ nomad_vault_default_identity_aud }}"]
    ttl = "{{ nomad_vault_default_identity_ttl }}"
  }
{% endif %}
}
{% endif %}