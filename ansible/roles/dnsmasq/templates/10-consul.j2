# Consul DNS forwarding configuration for dnsmasq
# Managed by Ansible — do not edit manually
#
# Forward all .global domain queries to the local Consul agent DNS server.
# Reference: https://developer.hashicorp.com/consul/docs/manage/dns/forwarding/enable

server=/{{ consul_domain | default('global') }}/{{ consul_dns_address }}#{{ consul_dns_port }}

# Reverse DNS for RFC 1918 networks — Consul handles PTR lookups for these ranges
{% for network in dnsmasq_consul_rev_networks %}
rev-server={{ network }},{{ consul_dns_address }}#{{ consul_dns_port }}
{% endfor %}
